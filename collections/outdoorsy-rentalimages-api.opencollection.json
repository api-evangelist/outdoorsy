            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates position on rental images and optionally set new primary image"
        },
        {
          "info": {
            "name": "listRentalImages",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "/v0/rentals/:rental_id/images",
