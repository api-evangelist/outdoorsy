{
  "opencollection": "1.0.0",
  "info": {
    "name": "Outdoorsy Search Documentation Get Homepage Parks API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "getHomepageParks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "parks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/parks/homepage"
          },
          "docs": "Get parks for Outdoorsy homepage"
        }
      ]
    }
  ],
  "bundled": true
}