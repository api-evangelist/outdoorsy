{
  "opencollection": "1.0.0",
  "info": {
    "name": "Outdoorsy API Documentation Usage Based Items API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "usageBasedItems",
        "type": "folder"
      },
      "items": [
