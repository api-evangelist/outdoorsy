            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns a breakdown of previous rentals, bookings or pending reviews."
        },
