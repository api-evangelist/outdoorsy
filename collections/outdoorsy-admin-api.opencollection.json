{
  "opencollection": "1.0.0",
  "info": {
    "name": "Outdoorsy API Documentation Admin API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "adminAuthCredsResendForUser",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "/v0/admin/users/:user_id/resend-confirmation"
          },
          "docs": "Resends email confirmation for a specific user (Admin only)"
        }
      ]
    }
  ],
  "bundled": true
}