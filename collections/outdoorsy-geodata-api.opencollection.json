{
  "opencollection": "1.0.0",
  "info": {
    "name": "Outdoorsy Search Documentation Geodata API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "geodata",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getAddressForIP",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/geodata/my-ip",
            "params": [
              {
                "name": "locale",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns geographic data based on request IP"
        }
      ]
    }
  ],
  "bundled": true
}